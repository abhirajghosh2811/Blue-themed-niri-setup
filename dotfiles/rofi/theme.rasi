* {
    bg: #080B12;
    surface: #0D1422;
    accent: #4C82C3;
    border: #1E3A5F;
    text: #C5D4E8;
    muted: #71839D;

    background-color: @bg;
    text-color: @text;
    font: "monospace 11";
}

window {
    width: 550px;
    border: 2px;
    border-color: @border;
    border-radius: 12px;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @border;
    border-radius: 8px;
    padding: 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;
}

listview {
    lines: 7;
    spacing: 5px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 7px;
    spacing: 10px;
}

element selected {
    background-color: @surface;
    text-color: @accent;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
